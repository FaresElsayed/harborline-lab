    %% EDI X12 004010 files in landing/edi (simulator/harborline/sim/edi.py)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#edi-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    %% file in landing/edi: landing/edi/<inbound|outbound>/<set>/<CLIENT>/<set>_<CLIENT>_<yyyyMMddHHmmss>_<ISA13>.edi, one interchange per file; older traffic in landing/edi/archive/.../<set>_<CLIENT>_<yyyyMM>.zip
    edi_file {
        string direction "<direction>: inbound or outbound folder"
        string set_id "<set>: 940, 856, 945 or 997"
        string client "<CLIENT>: the WMS owner code; joins wms_owner.owner_code"
        string file_ts "<yyyyMMddHHmmss>: when the file was written"
        string isa13 "<ISA13>: interchange control number"
    }

    %% ISA … IEA interchange: the envelope of every file: ISA is fixed width (106 characters with the terminator)
    edi_interchange {
        string ISA05 "ISA05: sender id qualifier: 01 (DUNS) or ZZ"
        string ISA06 "ISA06: sender id"
        string ISA07 "ISA07: receiver id qualifier"
        string ISA08 "ISA08: receiver id (HARBORLINE3PL on inbound files)"
        string ISA09 "ISA09: date yymmdd"
        string ISA10 "ISA10: time HHmm"
        string ISA12 "ISA12: version 00401"
        string ISA13 "ISA13: interchange control number, 9 digits"
        string ISA14 "ISA14: acknowledgment requested: 1 on 940 and 856"
        string ISA15 "ISA15: usage: P"
        string IEA01 "IEA01: number of groups"
        string IEA02 "IEA02: repeats ISA13"
    }

    %% GS … GE group: functional group inside the interchange
    edi_group {
        string GS01 "GS01: functional id: OW 940, SH 856, SW 945, FA 997"
        string GS02 "GS02: sender code"
        string GS03 "GS03: receiver code"
        string GS04 "GS04: date CCYYMMDD"
        string GS05 "GS05: time HHmm"
        string GS06 "GS06: group control number"
        string GS07 "GS07: X"
        string GS08 "GS08: 004010"
        string GE01 "GE01: number of transaction sets"
        string GE02 "GE02: repeats GS06"
    }

    %% ST … SE transaction set: one document (an order, an ASN, a shipping advice or an acknowledgment)
    edi_set {
        string ST01 "ST01: 940, 856, 945 or 997"
        string ST02 "ST02: set control number 0001, 0002, …"
        string SE01 "SE01: segments from ST to SE"
        string SE02 "SE02: repeats ST02"
    }

    %% 997 AK1 … AK9: functional acknowledgment, one per inbound group (outbound/997)
    edi997_group {
        string AK1_01 FK "AK1-01: functional id acknowledged: OW or SH; references edi_group.GS01"
        string AK1_02 FK "AK1-02: GS06 of the inbound group; references edi_group.GS06"
        string AK9_01 "AK9-01: A accepted, E errors"
        string AK9_02 "AK9-02: sets included"
        string AK9_03 "AK9-03: sets received"
        string AK9_04 "AK9-04: sets accepted"
    }

    %% 997 AK2 + AK5 per set: one pair per acknowledged transaction set
    edi997_set {
        string AK2_01 FK "AK2-01: set id acknowledged; references edi_set.ST01"
        string AK2_02 FK "AK2-02: ST02 of the inbound set; references edi_set.ST02"
        string AK5_01 "AK5-01: A accepted, E error"
        string AK5_02 "AK5-02: 4 when E"
    }

    %% 940 header: warehouse shipping order (inbound/940), segments before the LX loop and the W76 total
    edi940_header {
        string W05_01 "W05-01: N (original)"
        string W05_02 "W05-02: depositor order number SO-nnnnnnn"
        string W05_03 "W05-03: client PO; joins wms_order_header.client_order_ref"
        string N1_DE_02 "N1-02 (DE): client name"
        string N1_DE_04 "N1-04 (DE): client code; joins wms_owner.owner_code"
        string N1_WH_02 "N1-02 (WH): warehouse name"
        string N1_WH_04 "N1-04 (WH): warehouse code; joins wms_warehouse.warehouse_code"
        string N1_ST_02 "N1-02 (ST): ship-to name"
        string N1_ST_04 "N1-04 (ST): store number (qualifier 92), B2B only"
        string N3_01 "N3-01: ship-to street"
        string N4_01 "N4-01: city"
        string N4_02 "N4-02: state or province"
        string N4_03 "N4-03: postal code"
        string N4_04 "N4-04: country"
        string N9_PO_02 "N9-02 (PO): client PO again"
        string G62_10_02 "G62-02 (10): requested ship date"
        string W66_01 "W66-01: PP"
        string W66_02 "W66-02: M (LTL) or U (parcel)"
        string W66_10 "W66-10: carrier SCAC"
        string W76_01 "W76-01: total units"
        string W76_02 "W76-02: total weight"
        string W76_03 "W76-03: LB"
    }

    %% 940 line (LX loop): one LX loop per order line
    edi940_line {
        string LX_01 "LX-01: line sequence 1, 2, …"
        string W01_01 "W01-01: quantity ordered"
        string W01_02 "W01-02: unit of measure"
        string W01_03 "W01-03: UPC"
        string W01_04 "W01-04: VN"
        string W01_05 "W01-05: SKU; joins wms_material.sku"
        string G69_01 "G69-01: description"
    }

    %% 945 header: warehouse shipping advice (outbound/945) for a shipped EDI order
    edi945_header {
        string W06_01 "W06-01: F (final)"
        string W06_02 "W06-02: depositor order number (W05-02 of the 940)"
        string W06_03 "W06-03: ship date"
        string W06_04 "W06-04: shipment number; joins wms_shipment.shipment_nbr"
        string W06_05 "W06-05: WMS order number; joins wms_order_header.order_nbr"
        string W06_06 "W06-06: client PO; joins wms_order_header.client_order_ref"
        string N1_ST_02 "N1-02 (ST): ship-to name"
        string N3_01 "N3-01: ship-to street"
        string N4_01 "N4-01: city"
        string N4_02 "N4-02: state or province"
        string N4_03 "N4-03: postal code"
        string N4_04 "N4-04: country"
        string N1_SF_02 "N1-02 (SF): warehouse name"
        string N1_SF_04 "N1-04 (SF): warehouse code"
        string N9_BM_02 "N9-02 (BM): bill of lading (LTL); joins wms_shipment.bol_nbr"
        string N9_CN_02 "N9-02 (CN): tracking number; joins wms_shipment.tracking_nbr"
        string G62_11_02 "G62-02 (11): shipped date"
        string W27_01 "W27-01: M (LTL) or U (parcel)"
        string W27_02 "W27-02: SCAC; joins wms_shipment.scac"
        string W03_01 "W03-01: units shipped"
        string W03_02 "W03-02: weight"
        string W03_03 "W03-03: weight unit"
    }

    %% 945 line (LX loop): one LX loop per shipped order line
    edi945_line {
        string LX_01 "LX-01: line sequence 1, 2, …"
        string W12_01 "W12-01: CC complete, PR partial, BP backordered"
        string W12_02 "W12-02: quantity ordered"
        string W12_03 "W12-03: quantity shipped"
        string W12_04 "W12-04: difference"
        string W12_05 "W12-05: EA"
        string W12_06 "W12-06: UPC"
        string W12_07 "W12-07: VN"
        string W12_08 "W12-08: SKU; joins wms_material.sku"
        string W12_09 "W12-09: lot, when known"
    }

    %% 856 shipment (HL S): advance ship notice (inbound/856): header and shipment level
    edi856_shipment {
        string BSN_01 "BSN-01: 00 (original)"
        string BSN_02 "BSN-02: ASN number; joins wms_asn_header.asn_nbr"
        string BSN_03 "BSN-03: date"
        string BSN_04 "BSN-04: time"
        string DTM_011_02 "DTM-02 (011): shipped date"
        string DTM_017_02 "DTM-02 (017): expected date"
        string HL_01 "HL-01: 1"
        string HL_03 "HL-03: S (shipment)"
        string TD1_02 "TD1-02: pallets"
        string TD1_07 "TD1-07: gross weight, LB"
        string TD5_03 "TD5-03: carrier SCAC"
        string REF_BM_02 "REF-02 (BM): bill of lading"
        string N1_SF_02 "N1-02 (SF): supplier name"
        string N1_ST_02 "N1-02 (ST): warehouse name"
        string N1_ST_04 "N1-04 (ST): warehouse code; joins wms_warehouse.warehouse_code"
        string CTT_01 "CTT-01: number of HL segments"
    }

    %% 856 order (HL O): order level under the shipment
    edi856_order {
        string HL_01 "HL-01: 2"
        string HL_02 "HL-02: 1, the shipment level"
        string HL_03 "HL-03: O (order)"
        string PRF_01 "PRF-01: PO number (the ASN number with ASN- replaced by PO)"
    }

    %% 856 item (HL I): one item level per ASN line
    edi856_item {
        string HL_01 "HL-01: 3, 4, …"
        string HL_02 "HL-02: 2, the order level"
        string HL_03 "HL-03: I (item)"
        string LIN_VN_03 "LIN-03 (VN): SKU; joins wms_material.sku"
        string LIN_UP "LIN (UP): UPC, the element after UP, when known"
        string LIN_LT "LIN (LT): lot, the element after LT, when lot-controlled"
        string SN1_02 "SN1-02: quantity"
        string SN1_03 "SN1-03: unit of measure"
        string DTM_036_02 "DTM-02 (036): expiry date"
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): owner, only the columns the diagrams show
    wms_owner {
        integer owner_id PK
        varchar(10) owner_code UK
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): warehouse, only the columns the diagrams show
    wms_warehouse {
        smallint warehouse_id PK
        varchar(8) warehouse_code UK
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): order_header, only the columns the diagrams show
    wms_order_header {
        bigint order_id PK
        varchar(20) order_nbr UK
        varchar(40) client_order_ref
        varchar(8) channel
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): material, only the columns the diagrams show
    wms_material {
        integer material_id PK
        varchar(40) sku
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): shipment, only the columns the diagrams show
    wms_shipment {
        bigint shipment_id PK
        varchar(20) shipment_nbr UK
        bigint order_id FK
        varchar(4) scac
        varchar(40) tracking_nbr
        varchar(20) bol_nbr
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): asn_header, only the columns the diagrams show
    wms_asn_header {
        bigint asn_id PK
        varchar(30) asn_nbr
        smallint warehouse_id FK "references wms_warehouse.warehouse_id"
        varchar(100) supplier_name
        varchar(10) source
        date expected_date
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): asn_line, only the columns the diagrams show
    wms_asn_line {
        bigint asn_id PK, FK "references wms_asn_header.asn_id"
        integer line_nbr PK
        integer material_id FK "references wms_material.material_id"
        integer expected_qty
        varchar(30) lot_nbr
        date expiry_date
    }

