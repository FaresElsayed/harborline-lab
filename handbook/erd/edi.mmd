    wms_owner |o..o{ edi_file : "client = owner_code"
    edi_interchange ||--|{ edi_group : "contains"
    edi_group ||--|{ edi_set : "contains"
    edi_group |o..o{ edi997_group : "AK1_01 = GS01"
    edi_group |o..o{ edi997_group : "AK1_02 = GS06"
    edi_set |o..o{ edi997_set : "AK2_01 = ST01"
    edi_set |o..o{ edi997_set : "AK2_02 = ST02"
    edi997_group ||--|{ edi997_set : "contains"
    edi940_header ||--|{ edi940_line : "contains"
    wms_order_header |o..o{ edi940_header : "W05_03 = client_order_ref"
    wms_owner |o..o{ edi940_header : "N1_DE_04 = owner_code"
    wms_warehouse |o..o{ edi940_header : "N1_WH_04 = warehouse_code"
    wms_material |o..o{ edi940_line : "W01_05 = sku"
    wms_shipment |o..o{ edi945_header : "W06_04 = shipment_nbr"
    wms_order_header |o..o{ edi945_header : "W06_05 = order_nbr"
    wms_order_header |o..o{ edi945_header : "W06_06 = client_order_ref"
    wms_shipment |o..o{ edi945_header : "N9_BM_02 = bol_nbr"
    wms_shipment |o..o{ edi945_header : "N9_CN_02 = tracking_nbr"
    wms_shipment |o..o{ edi945_header : "W27_02 = scac"
    wms_material |o..o{ edi945_line : "W12_08 = sku"
    edi945_header ||--|{ edi945_line : "contains"
    edi856_shipment ||--|{ edi856_order : "contains"
    edi856_order ||--|{ edi856_item : "contains"
    wms_asn_header |o..o{ edi856_shipment : "BSN_02 = asn_nbr"
    wms_warehouse |o..o{ edi856_shipment : "N1_ST_04 = warehouse_code"
    wms_material |o..o{ edi856_item : "LIN_VN_03 = sku"
