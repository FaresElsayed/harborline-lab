    %% Month-end accounting rates keyed by Finance. Stored x100 per AX convention.
    exchangerate {
        bigint recid PK
        bigint exchangeratecurrencypair FK "references exchangeratecurrencypair.recid"
        numeric(32_16) exchangerate
        date validfrom
        date validto
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

