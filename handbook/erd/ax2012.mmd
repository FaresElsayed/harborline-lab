        bigint recid PK
        varchar(4) dataareaid FK "references dataarea.id"
        varchar(20) accountnum
        bigint party FK "references dirpartytable.recid"
        varchar(10) custgroup
        varchar(3) currency FK "references currency.currencycode"
        varchar(10) paymtermid FK "references paymterm.paymtermid"
        varchar(10) paymmode
        numeric(32_16) creditmax
        varchar(20) invoiceaccount
        varchar(10) taxgroup
        varchar(20) vatnum
        int blocked
        varchar(10) dlvmode
        varchar(10) inventlocation
        varchar(10) salesgroup
        varchar(10) lineofbusinessid
        varchar(20) segmentid
        bigint defaultdimension
        int onetimecustomer
        timestamp modifieddatetime
        varchar(20) modifiedby
        timestamp createddatetime
        varchar(20) createdby
        int recversion
        bigint partition
    }

    vendtable {
        bigint recid PK
