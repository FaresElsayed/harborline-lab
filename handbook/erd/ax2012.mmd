    exchangeratecurrencypair {
        bigint recid PK
        bigint exchangeratetype FK "references exchangeratetype.recid"
        varchar(3) fromcurrencycode FK "references currency.currencycode"
        varchar(3) tocurrencycode FK "references currency.currencycode"
        int exchangeratedisplayfactor
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
