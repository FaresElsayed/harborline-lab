        varchar(3) currencycodeiso
        varchar(5) symbol
        numeric(32_16) roundingprecision
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    exchangeratetype {
        bigint recid PK
        varchar(20) name
        varchar(60) description
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
