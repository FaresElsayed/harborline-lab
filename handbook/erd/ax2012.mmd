    %% Customer ledger. Invoice rows are UPDATED when settled (settleamountcur, closed, lastsettledate).
    custtrans {
        bigint recid PK
        varchar(4) dataareaid
        varchar(20) accountnum FK "references custtable.accountnum"
        varchar(20) voucher
        date transdate
        int transtype
        varchar(20) invoice FK "references custinvoicejour.invoiceid"
        varchar(60) txt
        numeric(32_16) amountcur
        numeric(32_16) amountmst
        numeric(32_16) settleamountcur
        numeric(32_16) settleamountmst
        varchar(3) currencycode
        numeric(32_16) exchrate
        date duedate
        date closed
        varchar(20) lastsettlevoucher
        date lastsettledate
        varchar(10) paymmode
        varchar(30) paymreference
        varchar(10) postingprofile
        varchar(20) documentnum
        date documentdate
        varchar(20) orderaccount
        int approved
        int correct
        int prepayment
        bigint offsetrecid
        bigint defaultdimension
        numeric(32_16) reportingcurrencyamount
        timestamp modifieddatetime
        varchar(20) modifiedby
        timestamp createddatetime
        varchar(20) createdby
        int recversion
        bigint partition
    }

    %% Links a payment to the invoice it settles. Reversed settlements are DELETED.
    custsettlement {
        bigint recid PK
        varchar(4) dataareaid
        bigint transrecid FK "references custtrans.recid"
        varchar(4) transcompany
        date transdate
        varchar(20) accountnum
        bigint offsetrecid FK "references custtrans.recid"
        varchar(20) offsettransvoucher
        varchar(20) offsetaccountnum
        varchar(4) offsetcompany
        numeric(32_16) settleamountcur
        numeric(32_16) settleamountmst
        numeric(32_16) exchadjustment
        numeric(32_16) utilizedcashdisc
        date duedate
        bigint settlementgroup
        int canbereversed
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

