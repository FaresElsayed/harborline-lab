    %% Journal lines. Lines of UNPOSTED journals are edited and deleted freely.
    ledgerjournaltrans {
        bigint recid PK
        varchar(4) dataareaid
        varchar(20) journalnum FK "references ledgerjournaltable.journalnum"
        numeric(32_16) linenum
        date transdate
