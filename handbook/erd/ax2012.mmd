    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#ax-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    dataarea {
        varchar(4) id PK
        varchar(60) name
        int isvirtual
        bigint recid UK
        int recversion
        bigint partition
    }

    dirpartytable {
        bigint recid PK
        varchar(20) partynumber
        varchar(100) name
        varchar(20) namealias
        varchar(100) knownas
        varchar(7) languageid
        int instancerelationtype
        bigint primaryaddresslocation FK "references logisticslocation.recid"
        bigint primarycontactemail
        bigint primarycontactphone
        timestamp modifieddatetime
        varchar(20) modifiedby
        timestamp createddatetime
        varchar(20) createdby
        int recversion
        bigint partition
    }

    logisticslocation {
        bigint recid PK
        varchar(20) locationid
        varchar(60) description
        int ispostaladdress
        bigint parentlocation
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    dirpartylocation {
        bigint recid PK
        bigint party FK "references dirpartytable.recid"
        bigint location FK "references logisticslocation.recid"
        int isprimary
        int ispostaladdress
        int islocationowner
        int isprivate
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    %% Date-effective. An address change sets VALIDTO on the current row and inserts a new row.
    logisticspostaladdress {
        bigint recid PK
        bigint location FK "references logisticslocation.recid"
        varchar(250) address
        varchar(250) street
        varchar(20) streetnumber
        varchar(60) city
        varchar(30) county
        varchar(10) state
        varchar(10) zipcode
        varchar(10) countryregionid
        varchar(60) districtname
        varchar(10) postbox
        numeric(32_16) latitude
        numeric(32_16) longitude
        int timezone
        timestamp validfrom
        int validfromtzid
        timestamp validto
        int validtotzid
        int isprivate
        bigint privateforparty
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    dirpersonname {
        bigint recid PK
        bigint person FK "references dirpartytable.recid"
        varchar(25) firstname
        varchar(25) middlename
        varchar(25) lastnameprefix
        varchar(25) lastname
        timestamp validfrom
        timestamp validto
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    hcmworker {
        bigint recid PK
        bigint person FK "references dirpartytable.recid"
        varchar(25) personnelnumber
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    hcmemployment {
        bigint recid PK
        bigint worker FK "references hcmworker.recid"
        bigint legalentity FK "references dataarea.recid"
        int employmenttype
        timestamp validfrom
        timestamp validto
        bigint defaultdimension
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    paymterm {
        bigint recid PK
        varchar(4) dataareaid FK "references dataarea.id"
        varchar(10) paymtermid
        varchar(60) description
        int paymmethod
        int numofdays
        int numofmonths
        varchar(10) cash
        int cutoffday
        timestamp modifieddatetime
        timestamp createddatetime
        int recversion
        bigint partition
    }

    %% Customers per legal entity. A client served by US and CA sites has one row in us01 and one in ca01.
