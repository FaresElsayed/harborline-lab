erDiagram
    %% Business files in landing/files (simulator/harborline/sim/files.py)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#files-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    %% rate card · Cover: landing/files/carriers/rate_cards/<SCAC>_rates_<yyyymmdd>.xlsx, sheet Cover: the name in column A, the value in column B
    rate_card_cover {
        string SCAC "the carrier; joins wms_carrier.scac"
        string Shipper
        string Account "Harborline's account number with the carrier"
        date Effective_date "Effective date"
        string General_rate_increase "General rate increase: percent over last year"
        string Mode "PARCEL or LTL"
        string Currency "per country, for example US: USD"
        string Weight_basis "Weight basis: per country, LB or KG"
        string Notes
    }

    %% rate card · <SVC>_<CC>: landing/files/carriers/rate_cards/<SCAC>_rates_<yyyymmdd>.xlsx: one sheet per service and country, for example GND_US; parcel sheets have a row per whole LB or KG, LTL sheets a row per weight break with rates per 100 lb
    rate_card_service {
        string sheet_SVC "<SVC>: service code, start of the sheet name; joins wms_carrier_service.service_code"
        string sheet_country "<CC>: country, end of the sheet name"
        integer Weight "Weight (LB|KG): parcel sheets"
        string Weight_break_LB "Weight break (LB): LTL sheets: 0-499 to 10000+"
        number Zone_2 "Zone 2: rate in the country's currency"
        number Zone_3 "Zone 3: rate in the country's currency"
        number Zone_4 "Zone 4: rate in the country's currency"
        number Zone_5 "Zone 5: rate in the country's currency"
        number Zone_6 "Zone 6: rate in the country's currency"
        number Zone_7 "Zone 7: rate in the country's currency"
        number Zone_8 "Zone 8: rate in the country's currency"
    }

    %% rate card · Fuel Surcharge: landing/files/carriers/rate_cards/<SCAC>_rates_<yyyymmdd>.xlsx, sheet Fuel Surcharge: one row per 10-cent band of the weekly US diesel price
    rate_card_fuel {
        number Diesel_from_USD_gal "Diesel from (USD/gal)"
        number Diesel_to_USD_gal "Diesel to (USD/gal)"
        number Ground_pct "Ground %: parcel cards"
        number Air_pct "Air %: parcel cards, air services"
        number LTL_pct "LTL %: LTL cards"
    }

    %% rate card · Accessorials: landing/files/carriers/rate_cards/<SCAC>_rates_<yyyymmdd>.xlsx, sheet Accessorials
    rate_card_accessorials {
        string Code "RESI, AHS, DAS on parcel cards; LIFTGATE, RESI on LTL cards"
        string Description
        number Amount "Amount (<currency>): one column per country"
    }

    %% budget · FY<yyyy> Budget: landing/files/finance/budget/budget_FY<yyyy>.xlsx (and budget_FY<yyyy>_reforecast.xlsx), sheet FY<yyyy> Budget or FY<yyyy> Reforecast: headers on row 5, a merged title row per site, subtotal rows, amounts in USD
    budget_sheet {
        string Site "warehouse code, or CORP; joins wms_warehouse.warehouse_code"
        string Account "AX main account, for example 4010; joins ax2012_mainaccount.mainaccountid"
        string Description
        number Jan "Jan-yy: a reforecast marks actual months with A"
        number Feb "Feb-yy: a reforecast marks actual months with A"
        number Mar "Mar-yy: a reforecast marks actual months with A"
        number Apr "Apr-yy: a reforecast marks actual months with A"
        number May "May-yy: a reforecast marks actual months with A"
        number Jun "Jun-yy: a reforecast marks actual months with A"
        number Jul "Jul-yy: a reforecast marks actual months with A"
        number Aug "Aug-yy: a reforecast marks actual months with A"
        number Sep "Sep-yy: a reforecast marks actual months with A"
        number Oct "Oct-yy: a reforecast marks actual months with A"
        number Nov "Nov-yy: a reforecast marks actual months with A"
        number Dec "Dec-yy: a reforecast marks actual months with A"
        number FY_Total "FY<yyyy> Total"
        string Comment
    }

    %% budget · Assumptions: landing/files/finance/budget/budget_FY<yyyy>.xlsx (and budget_FY<yyyy>_reforecast.xlsx), sheet Assumptions: headers on row 3
    budget_assumptions {
        string Currency "CAD, MXN, EUR, GBP; joins ax2012_currency.currencycode"
        number Budget_rate_USD_per_unit "Budget rate (USD per unit)"
    }

    %% warehouse master · Sites: landing/files/facilities/warehouse_master_<yyyymmdd>.xlsx, sheet Sites
    warehouse_master_sites {
        string Site_Code "Site Code: the warehouse code; joins wms_warehouse.warehouse_code"
        string Site_Name "Site Name"
        string Status "ACTIVE or PLANNED"
        string Street
        string City
        string State_Prov "State/Prov"
        string Postal_Code "Postal Code"
        string Country
        number Latitude
        number Longitude
        string Time_Zone "Time Zone: IANA zone"
        string Legal_Entity "Legal Entity: US01, CA01 or MX01 (upper case); joins ax2012_dataarea.id"
        string Weight_UOM "Weight UOM"
        string Dim_UOM "Dim UOM"
        integer Square_Feet "Square Feet"
        integer Dock_Doors "Dock Doors"
        integer Pallet_Positions "Pallet Positions"
        integer Pick_Faces "Pick Faces"
        string Temperature_Zones "Temperature Zones: zone types, comma separated"
        string Parcel_Cutoff "Parcel Cutoff"
        string LTL_Cutoff "LTL Cutoff"
        string Shifts
        date Opened
        string General_Manager "General Manager"
    }

    %% warehouse master · Zones: landing/files/facilities/warehouse_master_<yyyymmdd>.xlsx, sheet Zones
    warehouse_master_zones {
        string Site_Code FK "Site Code; references warehouse_master_sites.Site_Code"
        string Zone "zone type, for example COOLER; joins wms_zone.zone_type"
        number Temp_Min_C "Temp Min C"
        number Temp_Max_C "Temp Max C"
    }

    %% item master .csv: landing/files/clients/<CODE>/item_master_<yyyymmdd>[_delta].csv: delimiter, encoding, decimal separator, date format, booleans and header style per client (file_spec.txt); names below are the snake style
    item_master_csv {
        string client "<CODE> folder: client code; joins wms_owner.owner_code"
        string sku "other header styles: Item Number, ITEM_NO, Sku; joins wms_material.sku"
        string description "other header styles: Item Description, ITEM_DESC, Description"
        string upc "other header styles: UPC, UPC_CODE, Upc; joins wms_material.upc"
        string base_uom "other header styles: Base UOM, UOM, BaseUom"
        number unit_weight "other header styles: Unit Weight, WEIGHT, UnitWeight"
        string weight_uom "other header styles: Weight UOM, WT_UOM, WeightUom"
        number length "other header styles: Length, LEN, Length"
        number width "other header styles: Width, WID, Width"
        number height "other header styles: Height, HGT, Height"
        string dim_uom "other header styles: Dim UOM, DIM_UOM, DimUom"
        integer case_qty "other header styles: Case Pack, CASE_QTY, CaseQty"
        integer cases_per_pallet "other header styles: Cases Per Pallet, CS_PER_PLT, CasesPerPallet"
        string lot_controlled "other header styles: Lot Controlled, LOT_FLAG, LotControlled"
        string serial_controlled "other header styles: Serial Controlled, SERIAL_FLAG, SerialControlled"
        integer shelf_life_days "other header styles: Shelf Life (Days), SHELF_LIFE, ShelfLifeDays"
        string temp_class "other header styles: Temperature Class, TEMP_CLASS, TempClass"
        string hazmat_class "other header styles: Hazmat Class, HAZ_CLASS, HazmatClass"
        number unit_value "other header styles: Unit Cost, UNIT_COST, UnitValue"
        string country_of_origin "other header styles: Country of Origin, COO, CountryOfOrigin"
        string hs_code "other header styles: HTS Code, HTS, HsCode"
        string status "other header styles: Status, ITEM_STATUS, Status"
        date last_updated "other header styles: Last Updated, LAST_UPD, LastUpdated"
        string case_gtin "appears after an unannounced layout change; other styles: Case GTIN, CASE_GTIN, CaseGtin"
        string Notes "unannounced extra column"
    }

    %% file_spec.txt: landing/files/clients/<CODE>/file_spec.txt: the item-master format agreed at onboarding, one line each
    item_file_spec {
        string Client FK "references item_master_csv.client"
        string File_name "File name"
        string Delimiter
        string Encoding
        string Decimal_separator "Decimal separator"
        string Date_format "Date format"
        string Booleans
        string Header_style "Header style"
        string Cadence
        string Line_endings "Line endings"
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): carrier, only the columns the diagrams show
    wms_carrier {
        smallint carrier_id PK
        varchar(4) scac UK
        varchar(6) mode
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): carrier_service, only the columns the diagrams show
    wms_carrier_service {
        smallint service_id PK
        smallint carrier_id FK "references wms_carrier.carrier_id"
        varchar(6) service_code
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): owner, only the columns the diagrams show
    wms_owner {
        integer owner_id PK
        varchar(10) owner_code UK
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): material, only the columns the diagrams show
    wms_material {
        integer material_id PK
        integer owner_id FK "references wms_owner.owner_id"
        varchar(40) sku
        varchar(14) upc
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): warehouse, only the columns the diagrams show
    wms_warehouse {
        smallint warehouse_id PK
        varchar(8) warehouse_code UK
        varchar(40) time_zone
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): zone, only the columns the diagrams show
    wms_zone {
        integer zone_id PK
        smallint warehouse_id FK "references wms_warehouse.warehouse_id"
        varchar(20) zone_code
        varchar(12) zone_type
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): dataarea, only the columns the diagrams show
    ax2012_dataarea {
        varchar(4) id PK
        varchar(60) name
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): mainaccount, only the columns the diagrams show
    ax2012_mainaccount {
        bigint recid PK
        varchar(20) mainaccountid
        varchar(60) name
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): currency, only the columns the diagrams show
    ax2012_currency {
        bigint recid PK
        varchar(3) currencycode
    }

    wms_carrier |o..o{ rate_card_cover : "SCAC = scac"
    wms_carrier_service |o..o{ rate_card_service : "sheet_SVC = service_code"
    wms_carrier ||--o{ wms_carrier_service : "carrier_id"
    wms_owner ||--o{ wms_material : "owner_id"
    wms_owner |o..o{ item_master_csv : "client = owner_code"
    wms_material |o..o{ item_master_csv : "sku"
    wms_material |o..o{ item_master_csv : "upc"
    item_master_csv |o..o{ item_file_spec : "same client folder"
    wms_warehouse |o..o{ warehouse_master_sites : "Site_Code = warehouse_code"
    ax2012_dataarea |o..o{ warehouse_master_sites : "Legal_Entity = id"
    warehouse_master_sites |o..o{ warehouse_master_zones : "Site_Code"
    wms_zone |o..o{ warehouse_master_zones : "Zone = zone_type"
    wms_warehouse ||--o{ wms_zone : "warehouse_id"
    wms_warehouse |o..o{ budget_sheet : "Site = warehouse_code"
    ax2012_mainaccount |o..o{ budget_sheet : "Account = mainaccountid"
    ax2012_currency |o..o{ budget_assumptions : "Currency = currencycode"
