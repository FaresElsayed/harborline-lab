    %% IoT sensor gateway: database iot, schema telemetry (simulator/harborline/schema/iot.sql)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#iot-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    sensor {
        varchar(24) sensor_id PK
        varchar(8) warehouse_code "joins wms_warehouse.warehouse_code"
        varchar(20) zone_code "joins wms_zone.zone_code"
        varchar(8) sensor_type
        varchar(4) unit
        varchar(40) model
        date installed_date
        date calibration_due
        boolean is_active
    }

    %% Append-only. Nominal cadence 5 minutes. Late flushes and duplicate sends happen.
    sensor_reading {
        bigint reading_id PK
        varchar(24) sensor_id FK "references sensor.sensor_id"
        bigint device_ts_ms
        double_precision value
        smallint battery_pct
        timestamptz ingested_at
    }

    dock_door_event {
        bigint event_id PK
        varchar(8) warehouse_code "joins wms_warehouse.warehouse_code"
        smallint door_nbr "joins wms_location.location_code; joins wms_receipt_header.dock_door"
        varchar(6) event_type
        varchar(20) trailer_nbr "joins wms_receipt_header.trailer_nbr"
        bigint device_ts_ms
        timestamptz ingested_at
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): warehouse, only the columns the diagrams show
    wms_warehouse {
        smallint warehouse_id PK
        varchar(8) warehouse_code UK
        varchar(40) time_zone
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): zone, only the columns the diagrams show
    wms_zone {
        integer zone_id PK
        smallint warehouse_id FK "references wms_warehouse.warehouse_id"
        varchar(20) zone_code
        varchar(12) zone_type
        numeric(5_1) temp_min_c
        numeric(5_1) temp_max_c
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): location, only the columns the diagrams show
    wms_location {
        integer location_id PK
        integer zone_id FK "references wms_zone.zone_id"
        varchar(20) location_code
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): receipt_header, only the columns the diagrams show
    wms_receipt_header {
        bigint receipt_id PK
        smallint warehouse_id FK "references wms_warehouse.warehouse_id"
        varchar(6) dock_door
        varchar(20) trailer_nbr
    }

    sensor ||..o{ sensor_reading : "sensor_id"
    wms_warehouse |o..o{ sensor : "warehouse_code"
    wms_zone |o..o{ sensor : "zone_code"
    wms_warehouse |o..o{ dock_door_event : "warehouse_code"
    wms_location |o..o{ dock_door_event : "door_nbr 7 = location_code DOOR-07"
    wms_receipt_header |o..o{ dock_door_event : "door_nbr 7 = dock_door D07"
    wms_receipt_header |o..o{ dock_door_event : "trailer_nbr"
    wms_warehouse ||--o{ wms_zone : "warehouse_id"
    wms_zone ||--o{ wms_location : "zone_id"
    wms_warehouse ||..o{ wms_receipt_header : "warehouse_id"
