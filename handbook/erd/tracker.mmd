    %% Harborline Tracker: database tracker, schema tracker (simulator/harborline/tracker/tracker.sql)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#tracker-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    settings {
        varchar(40) key PK
        jsonb value
        timestamptz updated_at
    }

    sprint {
        smallint id PK
        varchar(40) name
        smallint project
        text goal
        date start_date
        date end_date
        varchar(10) state
        timestamptz started_at
        timestamptz completed_at
    }

    issue {
        varchar(20) key PK
        integer num UK
        varchar(40) source_id UK
        varchar(8) origin
        boolean removed
        smallint project
        varchar(10) type
        varchar(255) summary
        text description
        varchar(12) status
        varchar(8) priority
        varchar(40) reporter
        varchar(40) assignee
        varchar(40) department
        varchar(20) epic_key FK "references issue.key"
        varchar(20) parent_key FK "references issue.key"
        smallint sprint_id FK "references sprint.id"
        numeric(5_1) story_points
        numeric(6_1) estimate_hours
        smallint due_day
        smallint start_day
        date due_date
        date start_date
        text[] labels
        text[] components
        text[] attachments
        text[] dashboards
        jsonb definition_of_done
        varchar(400) pr_url
        timestamptz created_at
        timestamptz updated_at
        timestamptz resolved_at
    }

    rank {
        varchar(20) issue_key PK, FK "references issue.key"
        numeric rank
    }

    ac_check {
        varchar(20) issue_key PK, FK "references issue.key"
        smallint idx PK
        text text
        boolean checked
        timestamptz checked_at
    }

    comment {
        bigserial id PK
        varchar(20) issue_key FK "references issue.key"
        varchar(40) author
        text body
        timestamptz created_at
        timestamptz updated_at
    }

    worklog {
        bigserial id PK
        varchar(20) issue_key FK "references issue.key"
        varchar(40) author
        numeric(5_2) hours
        date work_date
        text note
        timestamptz created_at
    }

    history {
        bigserial id PK
        varchar(20) issue_key FK "references issue.key"
        varchar(30) field
        text from_value
        text to_value
        varchar(40) author
        timestamptz changed_at
    }

    link {
        bigserial id PK
        varchar(20) from_key FK "references issue.key"
        varchar(20) to_key FK "references issue.key"
        varchar(20) link_type
        varchar(8) origin
    }

    sprint |o--o{ issue : "sprint_id = id"
    issue ||--o| rank : "issue_key = key"
    issue ||--o{ ac_check : "issue_key = key"
    issue |o..o{ issue : "epic_key = key"
    issue |o..o{ issue : "parent_key = key"
    issue ||--o{ comment : "issue_key = key"
    issue ||--o{ worklog : "issue_key = key"
    issue ||--o{ history : "issue_key = key"
    issue ||--o{ link : "from_key = key"
    issue ||--o{ link : "to_key = key"
