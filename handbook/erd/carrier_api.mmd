erDiagram
    %% Carrier tracking API http://localhost:8080/carrier/v1 (simulator/harborline/api/carrier_api.py) and its history export (simulator/harborline/sim/files.py)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#carrier-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    %% GET /tracking-events: GET /carrier/v1/tracking-events?since=&cursor=&limit= (limit 1 to 500), header X-API-Key
    tracking_events_page {
        array events "tracking events ordered by received_at, event_id"
        string next_cursor "send back as cursor= for the next page"
        boolean has_more
    }

    %% tracking event (JSON): one element of events[]
    tracking_event {
        integer event_id PK
        string tracking_nbr "joins wms_shipment.tracking_nbr; joins wms_shipment_carton.tracking_nbr"
        string scac "joins wms_carrier.scac"
        string event_code "LABEL_CREATED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, RETURN_TO_SENDER"
        string event_local_ts "ISO-8601 with the carrier's local UTC offset"
        string description
        string exception_code "WEATHER, ADDRESS, DAMAGED, REFUSED, CARRIER_DELAY; null otherwise"
        string location_city "location.city"
        string location_state_prov "location.state_prov"
        string location_country_code "location.country_code"
        string received_at "UTC, when the aggregator received it"
        boolean is_correction
    }

    %% GET /shipments/{nbr}: GET /carrier/v1/shipments/{tracking_nbr}
    shipment_tracking {
        string tracking_nbr
        string scac
        string status "event_code of the latest event"
        array events "every event of the package"
    }

    %% history export .csv.gz: landing/files/carrier/history_export/tracking_events_<yyyymm>.csv.gz: one file per month of events older than the API's 90-day retention
    tracking_history_csv {
        integer event_id FK "references tracking_event.event_id"
        string tracking_nbr
        string scac
        string event_code
        string event_ts_utc "when it happened, UTC"
        string event_local_ts "when it happened, carrier's local offset"
        string city
        string state_prov
        string country_code
        string description
        string exception_code
        string received_at_utc "when the aggregator received it"
        boolean is_correction
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): shipment, only the columns the diagrams show
    wms_shipment {
        bigint shipment_id PK
        varchar(20) shipment_nbr UK
        varchar(4) scac
        varchar(40) tracking_nbr
        varchar(10) shipment_status
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): shipment_carton, only the columns the diagrams show
    wms_shipment_carton {
        bigint carton_id PK
        bigint shipment_id FK "references wms_shipment.shipment_id"
        varchar(20) carton_nbr
        varchar(40) tracking_nbr
    }

    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql): carrier, only the columns the diagrams show
    wms_carrier {
        smallint carrier_id PK
        varchar(4) scac UK
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): vendinvoicetrans, only the columns the diagrams show
    ax2012_vendinvoicetrans {
        varchar(20) internalinvoiceid FK "references ax2012_vendinvoicejour.internalinvoiceid"
        varchar(1000) name "joins wms_shipment.tracking_nbr"
        numeric(32_16) lineamount
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): vendinvoicejour, only the columns the diagrams show
    ax2012_vendinvoicejour {
        varchar(30) invoiceid
        varchar(20) internalinvoiceid
        date invoicedate
        varchar(20) invoiceaccount FK "references ax2012_vendtable.accountnum"
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): vendtable, only the columns the diagrams show
    ax2012_vendtable {
        varchar(20) accountnum
        bigint party FK
        varchar(10) vendgroup
    }

    tracking_events_page ||--o{ tracking_event : "events[]"
    shipment_tracking ||--|{ tracking_event : "events[]"
    tracking_event |o..o{ tracking_history_csv : "same event, older than 90 days"
    wms_shipment |o..o{ tracking_event : "tracking_nbr"
    wms_shipment_carton |o..o{ tracking_event : "tracking_nbr (first carton)"
    wms_carrier |o..o{ tracking_event : "scac"
    wms_shipment ||--o{ wms_shipment_carton : "shipment_id"
    wms_shipment |o..o{ ax2012_vendinvoicetrans : "name contains TRK <tracking_nbr>"
    ax2012_vendinvoicejour ||..o{ ax2012_vendinvoicetrans : "internalinvoiceid"
    ax2012_vendtable ||..o{ ax2012_vendinvoicejour : "invoiceaccount = accountnum"
