erDiagram
    %% Harborline WMS: database wms, schema wms (simulator/harborline/schema/wms.sql)
    %% Generated by simulator/harborline/tools/build_data_dictionary.py together with the diagrams in
    %% handbook/source-systems.html#wms-erd. Do not edit by hand.
    %% Every entity with every column. Lines: -- a key the system enforces, or nesting inside a file;
    %% .. a join only the application makes, or a join to another system (entities named <system>_<name>).
    %% Types: commas and spaces in SQL types become _, so numeric(12_2) means numeric(12,2).

    %% Physical distribution centers operated by Harborline.
    warehouse {
        smallint warehouse_id PK
        varchar(8) warehouse_code UK
        varchar(80) warehouse_name
        varchar(100) address1
        varchar(60) city
        varchar(10) state_prov
        varchar(12) postal_code
        char(2) country_code
        varchar(40) time_zone
        varchar(2) weight_uom
        varchar(2) dim_uom
        boolean is_active
        date opened_date
        timestamp create_ts
        timestamp mod_ts
    }

    %% Storage zones inside a warehouse. Temperature range applies to COOLER/FREEZER zones.
    zone {
        integer zone_id PK
        smallint warehouse_id FK "references warehouse.warehouse_id"
        varchar(20) zone_code
        varchar(12) zone_type
        numeric(5_1) temp_min_c
        numeric(5_1) temp_max_c
        boolean is_active
        timestamp create_ts
        timestamp mod_ts
    }

    %% Bin / slot master. Re-slotting updates zone_id and location_type in place.
    location {
        integer location_id PK
        smallint warehouse_id FK "references warehouse.warehouse_id"
        integer zone_id FK "references zone.zone_id"
        varchar(20) location_code
        varchar(4) aisle
        varchar(4) bay
        varchar(2) level
        varchar(2) position
        varchar(10) location_type
        numeric(9_2) max_weight
        numeric(9_2) max_volume
        boolean is_active
        timestamp create_ts
        timestamp mod_ts
    }

    %% Clients (depositors) whose inventory Harborline stores. One row per client.
    owner {
        integer owner_id PK
        varchar(10) owner_code UK
        varchar(100) owner_name
        varchar(12) owner_status
        varchar(20) vertical
        varchar(20) erp_account_nbr
        char(3) billing_currency
        smallint primary_warehouse_id FK "references warehouse.warehouse_id"
        varchar(100) contact_name
        varchar(120) contact_email
        date go_live_date
        timestamp create_ts
        timestamp mod_ts
        varchar(30) create_user
        varchar(30) mod_user
    }

    owner_warehouse {
        integer owner_id PK, FK "references owner.owner_id"
        smallint warehouse_id PK, FK "references warehouse.warehouse_id"
        date active_from
        date active_to
    }

    %% Item master per client. Dimension/weight corrections overwrite in place.
    material {
        integer material_id PK
        integer owner_id FK "references owner.owner_id"
        varchar(40) sku
        varchar(200) description
        varchar(14) upc
        varchar(4) base_uom
        numeric(10_3) unit_weight
        varchar(2) weight_uom
        numeric(8_2) unit_length
        numeric(8_2) unit_width
        numeric(8_2) unit_height
        varchar(2) dim_uom
        integer case_qty
        integer cases_per_pallet
        boolean is_lot_controlled
        boolean is_serial_controlled
        integer shelf_life_days
        varchar(8) temp_class
        varchar(6) hazmat_class
        numeric(12_2) unit_value
        char(2) country_of_origin
        varchar(12) hs_code
        varchar(12) material_status
        timestamp create_ts
        timestamp mod_ts
        varchar(30) create_user
        varchar(30) mod_user
    }

    material_uom {
        integer material_id PK, FK "references material.material_id"
        varchar(4) uom_code PK
        integer qty_per_uom
        numeric(10_3) weight
        numeric(8_2) length
        numeric(8_2) width
        numeric(8_2) height
        timestamp mod_ts
    }

    carrier {
        smallint carrier_id PK
        varchar(4) scac UK
        varchar(60) carrier_name
        varchar(6) mode
        boolean is_active
        timestamp mod_ts
    }

    carrier_service {
        smallint service_id PK
        smallint carrier_id FK "references carrier.carrier_id"
        varchar(6) service_code
        varchar(60) service_name
        smallint transit_days_min
        smallint transit_days_max
        boolean is_active
        timestamp mod_ts
    }

    asn_header {
        bigint asn_id PK
        varchar(30) asn_nbr
        integer owner_id
        smallint warehouse_id FK
        varchar(100) supplier_name
        varchar(10) source
        date expected_date
        varchar(14) asn_status
        timestamp create_ts
        timestamp mod_ts
    }

    asn_line {
        bigint asn_id PK, FK "references asn_header.asn_id"
        integer line_nbr PK
        integer material_id FK "references material.material_id"
        integer expected_qty
        varchar(4) uom
        varchar(30) lot_nbr
        date expiry_date
    }

    receipt_header {
        bigint receipt_id PK
        varchar(30) receipt_nbr
        bigint asn_id FK "references asn_header.asn_id"
        integer owner_id
        smallint warehouse_id FK
        varchar(6) dock_door
        varchar(20) trailer_nbr
        timestamp arrived_ts
        timestamp started_ts
        timestamp completed_ts
        varchar(12) receipt_status
        timestamp create_ts
        timestamp mod_ts
    }

    receipt_line {
        bigint receipt_id PK, FK "references receipt_header.receipt_id"
        integer line_nbr PK
        integer material_id FK "references material.material_id"
        bigint lpn_id FK "references license_plate.lpn_id"
        integer received_qty
        integer damaged_qty
        varchar(4) uom
        varchar(30) lot_nbr
        date expiry_date
        timestamp received_ts
        integer received_by
    }

    license_plate {
        bigint lpn_id PK
        varchar(20) lpn_nbr UK
        smallint warehouse_id
        integer location_id FK "references location.location_id"
        varchar(6) lpn_type
        varchar(10) lpn_status
        timestamp create_ts
        timestamp mod_ts
    }

    %% Current on-hand by location / LPN / lot. Rows are physically DELETED when qty_on_hand reaches 0.
    inventory {
        bigint inventory_id PK
        smallint warehouse_id
        integer location_id FK "references location.location_id"
        bigint lpn_id FK "references license_plate.lpn_id"
        integer owner_id
        integer material_id FK "references material.material_id"
        varchar(30) lot_nbr
        date expiry_date
        integer qty_on_hand
        integer qty_allocated
        varchar(10) inv_status
        varchar(30) hold_reason
        date received_date
        timestamp create_ts
        timestamp mod_ts
    }

    %% Immutable inventory ledger. Corrections are new reversing rows, never updates.
    inventory_txn {
        bigint txn_id PK
        timestamp txn_ts
        smallint warehouse_id
        integer owner_id
        integer material_id FK "references material.material_id"
        varchar(10) txn_type
        integer qty
        integer from_location_id FK "references location.location_id"
        integer to_location_id FK "references location.location_id"
        bigint lpn_id FK "references license_plate.lpn_id"
        varchar(30) lot_nbr
        varchar(20) reason_code
        varchar(10) ref_type
        bigint ref_id FK "references receipt_header.receipt_id; references task.task_id; references cycle_count.count_id; references order_header.order_id; references return_header.return_id"
        integer user_id FK "references app_user.user_id"
        timestamp create_ts
    }

    %% Outbound orders. Contains consumer PII (ship_to_*).
    order_header {
        bigint order_id PK
        varchar(20) order_nbr UK
        integer owner_id FK "references owner.owner_id"
        smallint warehouse_id
        varchar(40) client_order_ref
        varchar(10) order_type
        varchar(8) channel
        varchar(12) order_status
        smallint priority
        timestamp ordered_ts
        timestamp received_ts
        date requested_ship_date
        smallint carrier_service_id FK "references carrier_service.service_id"
        varchar(100) ship_to_name
        varchar(100) ship_to_company
        varchar(120) ship_to_address1
        varchar(120) ship_to_address2
        varchar(60) ship_to_city
        varchar(10) ship_to_state
        varchar(12) ship_to_postal
        char(2) ship_to_country
        varchar(30) ship_to_phone
        varchar(120) ship_to_email
        boolean is_residential
        integer total_lines
        integer total_units
        varchar(40) cancel_reason
        timestamp create_ts
        timestamp mod_ts
        varchar(30) create_user
        varchar(30) mod_user
    }

    %% Order lines. No audit timestamp. Cancelled lines are DELETED.
    order_line {
        bigint order_id PK, FK "references order_header.order_id"
        integer line_nbr PK
        integer material_id FK "references material.material_id"
        integer ordered_qty
        integer allocated_qty
        integer picked_qty
        integer shipped_qty
        varchar(4) uom
        numeric(12_2) unit_price
        varchar(12) line_status
    }

    %% Labor tasks. A nightly housekeeping job DELETES tasks older than 180 days.
    task {
        bigint task_id PK
        smallint warehouse_id
        varchar(8) task_type
        varchar(12) task_status
        smallint priority
        bigint order_id FK "references order_header.order_id"
        integer order_line_nbr
        bigint receipt_id
        integer material_id
        integer qty
        integer from_location_id
        integer to_location_id
        integer assigned_user_id FK "references app_user.user_id"
        timestamp created_ts
        timestamp assigned_ts
        timestamp started_ts
        timestamp completed_ts
        timestamp mod_ts
    }

    shipment {
        bigint shipment_id PK
        varchar(20) shipment_nbr UK
        bigint order_id FK "references order_header.order_id"
        smallint warehouse_id
        smallint carrier_service_id FK "references carrier_service.service_id"
        varchar(4) scac
        varchar(40) tracking_nbr
        varchar(20) bol_nbr
        timestamp ship_ts
        varchar(10) shipment_status
        numeric(10_2) total_weight
        varchar(2) weight_uom
        integer carton_count
        numeric(10_2) freight_charge_est
        char(3) currency
        timestamp create_ts
        timestamp mod_ts
    }

    %% Packages. Voided labels are DELETED.
    shipment_carton {
        bigint carton_id PK
        bigint shipment_id FK "references shipment.shipment_id"
        varchar(20) carton_nbr
        varchar(40) tracking_nbr
        numeric(10_2) weight
        numeric(8_2) length
        numeric(8_2) width
        numeric(8_2) height
        varchar(2) dim_uom
        timestamp create_ts
        timestamp mod_ts
    }

    cycle_count {
        bigint count_id PK
        smallint warehouse_id
        integer location_id FK "references location.location_id"
        integer material_id FK "references material.material_id"
        varchar(30) lot_nbr
        integer system_qty
        integer counted_qty
        integer variance_qty
        timestamp count_ts
        integer counted_by
        varchar(10) count_status
        integer approved_by
        timestamp create_ts
        timestamp mod_ts
    }

    return_header {
        bigint return_id PK
        varchar(20) rma_nbr
        integer owner_id
        smallint warehouse_id
        bigint original_order_id FK "references order_header.order_id"
        varchar(40) carrier_tracking_nbr
        timestamp received_ts
        varchar(10) return_status
        timestamp create_ts
        timestamp mod_ts
    }

    return_line {
        bigint return_id PK, FK "references return_header.return_id"
        integer line_nbr PK
        integer material_id FK "references material.material_id"
        integer qty
        varchar(20) reason_code
        varchar(10) disposition
    }

    app_user {
        integer user_id PK
        varchar(30) username UK
        varchar(40) first_name
        varchar(40) last_name
        varchar(20) personnel_nbr
        smallint warehouse_id FK "references warehouse.warehouse_id"
        varchar(12) user_role
        char(1) shift
        date hire_date
        date term_date
        boolean is_active
        timestamp create_ts
        timestamp mod_ts
    }

    %% Rates keyed by billing analysts from the signed contract. Updated IN PLACE - no history kept.
    billing_rate {
        integer rate_id PK
        integer owner_id FK "references owner.owner_id"
        smallint warehouse_id FK "references warehouse.warehouse_id"
        varchar(10) charge_code "joins salesforce_Rate_Card_Line__c.Charge_Code__c"
        numeric(12_4) rate
        varchar(14) rate_uom
        char(3) currency
        date effective_date
        timestamp mod_ts
        varchar(30) mod_user
    }

    %% Billable activity accrued daily. Exported to AX at month end. Corrections before invoicing are DELETED or re-rated.
    billing_record {
        bigint billing_id PK
        integer owner_id FK "references owner.owner_id"
        smallint warehouse_id FK "references warehouse.warehouse_id"
        varchar(10) charge_code "joins ax2012_custinvoicetrans.itemid"
        date activity_date
        numeric(12_2) qty
        numeric(12_4) rate
        numeric(14_2) amount
        char(3) currency
        varchar(10) ref_type
        bigint ref_id
        varchar(10) billing_status
        varchar(20) invoice_ref "joins ax2012_custinvoicejour.invoiceid"
        timestamp create_ts
        timestamp mod_ts
    }

    %% WMS application releases. Schema changes ship with a release.
    sys_release {
        integer release_id PK
        varchar(12) version
        timestamp released_ts
        text notes
    }

    %% Salesforce objects, REST API v67.0 (simulator/harborline/schema/salesforce_objects.yaml): Rate_Card_Line__c, only the columns the diagrams show
    salesforce_Rate_Card_Line__c {
        reference Rate_Card__c FK "references Rate_Card__c"
        picklist Charge_Code__c
        currency Rate__c
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): custinvoicetrans, only the columns the diagrams show
    ax2012_custinvoicetrans {
        varchar(20) invoiceid FK "references ax2012_custinvoicejour.invoiceid"
        varchar(20) itemid
        numeric(32_16) lineamount
    }

    %% Microsoft Dynamics AX 2012: database ax2012, schema dbo (simulator/harborline/schema/ax2012.sql): custinvoicejour, only the columns the diagrams show
    ax2012_custinvoicejour {
        varchar(20) invoiceid
        date invoicedate
        varchar(20) invoiceaccount FK
    }

    warehouse ||--o{ zone : "warehouse_id"
    warehouse ||--o{ location : "warehouse_id"
    zone ||--o{ location : "zone_id"
    carrier ||--o{ carrier_service : "carrier_id"
    warehouse ||--o{ owner_warehouse : "warehouse_id"
    warehouse |o..o{ app_user : "warehouse_id"
    owner ||--o{ owner_warehouse : "owner_id"
    warehouse |o--o{ owner : "primary_warehouse_id = warehouse_id"
    owner ||--o{ material : "owner_id"
    material ||--o{ material_uom : "material_id"
    asn_header ||--o{ asn_line : "asn_id"
    asn_header |o..o{ receipt_header : "asn_id"
    receipt_header ||--o{ receipt_line : "receipt_id"
    material ||..o{ asn_line : "material_id"
    material ||..o{ receipt_line : "material_id"
    license_plate |o..o{ receipt_line : "lpn_id"
    location |o..o{ license_plate : "location_id"
    location ||..o{ inventory : "location_id"
    license_plate |o..o{ inventory : "lpn_id"
    material ||..o{ inventory : "material_id"
    location ||..o{ cycle_count : "location_id"
    material ||..o{ cycle_count : "material_id"
    receipt_header |o..o{ inventory_txn : "ref_id where ref_type = RECEIPT"
    task |o..o{ inventory_txn : "ref_id where ref_type = TASK"
    cycle_count |o..o{ inventory_txn : "ref_id where ref_type = COUNT"
    location |o..o{ inventory_txn : "from_location_id = location_id"
    location |o..o{ inventory_txn : "to_location_id = location_id"
    order_header |o..o{ inventory_txn : "ref_id where ref_type = ORDER"
    return_header |o..o{ inventory_txn : "ref_id where ref_type = RETURN"
    material ||..o{ inventory_txn : "material_id"
    license_plate |o..o{ inventory_txn : "lpn_id"
    app_user |o..o{ inventory_txn : "user_id"
    owner ||..o{ order_header : "owner_id"
    order_header ||--o{ order_line : "order_id"
    material ||..o{ order_line : "material_id"
    order_header |o..o{ task : "order_id"
    app_user |o..o{ task : "assigned_user_id = user_id"
    carrier_service |o..o{ order_header : "carrier_service_id = service_id"
    order_header ||..o{ shipment : "order_id"
    carrier_service ||..o{ shipment : "carrier_service_id = service_id"
    order_header |o..o{ return_header : "original_order_id = order_id"
    material ||..o{ return_line : "material_id"
    shipment ||--o{ shipment_carton : "shipment_id"
    return_header ||--o{ return_line : "return_id"
    owner ||..o{ billing_rate : "owner_id"
    warehouse |o..o{ billing_rate : "warehouse_id"
    owner ||..o{ billing_record : "owner_id"
    warehouse ||..o{ billing_record : "warehouse_id"
    salesforce_Rate_Card_Line__c |o..o{ billing_rate : "charge_code = Charge_Code__c"
    ax2012_custinvoicejour |o..o{ billing_record : "invoice_ref = invoiceid"
    ax2012_custinvoicetrans |o..o{ billing_record : "charge_code = itemid"
    ax2012_custinvoicejour ||..o{ ax2012_custinvoicetrans : "invoiceid"
