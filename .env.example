# Harborline 3PL Simulator settings. start.bat / start.sh copy this file to .env the first time.
# Change values in .env (not here), then run start.bat again.

# --- Postgres -------------------------------------------------------------------------------------
# Superuser password (only used inside Docker to set things up).
POSTGRES_PASSWORD=harborline-admin
# The simulator's own login (owns the source databases).
HL_APP_PASSWORD=harborline-app
# YOUR login for ingestion and CDC: user etl_reader (read-only, REPLICATION).
HL_ETL_PASSWORD=etl-reader-2026
# Iris Novak's login for dashboard reviews: user uat_reviewer (read-only on wms, ax2012, iot). Her skill reads this
# line; your pipelines never use it.
HL_REVIEWER_PASSWORD=uat-review-2026
# Port on your machine for Postgres. Change it if 5432 is taken (for example by a local Postgres install).
HL_PG_PORT=5432

# --- Web app and APIs ------------------------------------------------------------------------------
# Control Center, tracker, handbook, mock Salesforce (/sfdc) and carrier (/carrier/v1) APIs.
HL_APP_PORT=8080
# 127.0.0.1 = reachable from this computer only (recommended). 0.0.0.0 = reachable from your network.
HL_BIND_ADDR=127.0.0.1

# --- Mock Salesforce (OAuth 2.0 client credentials) -----------------------------------------------
SF_CLIENT_ID=3MVG9harborline.etl.client
SF_CLIENT_SECRET=hl-sf-secret-7c41

# --- Mock carrier tracking API (header X-API-Key) --------------------------------------------------
CARRIER_API_KEY=hl-carrier-live-5e2a9d

# --- Simulation ----------------------------------------------------------------------------------
# Default size offered by the Build button: small (6 months), medium (24), large (36).
HL_DEFAULT_PRESET=medium
# Same seed + same preset = same data.
HL_SEED=20261031
# 1 = never call the public FX / weather APIs during a build (use the bundled series).
HL_OFFLINE=0
